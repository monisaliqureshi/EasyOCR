FROM python:3.10-slim

ARG gh_username=JaidedAI
ARG service_home="/home/EasyOCR"

# Install system dependencies required by OpenCV and other packages
RUN apt-get update -y && \
    apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1-mesa-dev \
    git \
    # cleanup
    && apt-get autoremove -y \
    && apt-get clean -y \
    && rm -rf /var/lib/apt/lists

# Install CPU-only PyTorch (avoids pulling in large CUDA binaries)
RUN pip install --no-cache-dir torch torchvision \
    --index-url https://download.pytorch.org/whl/cpu

# Clone EasyOCR repo and install
RUN mkdir "$service_home" \
    && git clone "https://github.com/$gh_username/EasyOCR.git" "$service_home" \
    && cd "$service_home" \
    && git remote add upstream "https://github.com/JaidedAI/EasyOCR.git" \
    && git pull upstream master

RUN cd "$service_home" \
    && pip install --no-cache-dir -r requirements-cpu.txt \
    && pip install --no-cache-dir -e .
